# CashBridge environment settings. Copy to .env and adjust.

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, OpenAI, local vLLM/Ollama/LM Studio) ---
# Base URL and key are read from the environment; nothing is hardcoded in the code.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://cleanapis.com/v1
OPENROUTER_MODEL=gpt-5.6-luna

# Use deterministic template explanations (no LLM API calls). 1 = mock, 0 = real LLM.
MOCK_LLM=1

# --- Data ---
CASHBRIDGE_DB=cashbridge.db

# --- Sandbox bank limits ---
SANDBOX_MAX_PRINCIPAL=25000000
